[matrix]
homeserver = "https://matrix.org"
user_id = "@emailbot:matrix.org"
# Secrets may instead come from MATRIX_ACCESS_TOKEN / MATRIX_RECOVERY_KEY.
access_token = "YOUR_ACCESS_TOKEN"
device_id = "YOUR_DEVICE_ID"
# recovery_key = "EsXX xxxx xxxx xxxx xxxx xxxx xxxx xxxx"

[imap]
host = "mail.example.com"
port = 993
username = "bot@example.com"
# password loaded from IMAP_PASSWORD env var
mailbox = "INBOX"
poll_interval_secs = 60
initial_fetch_limit = 50
skip_initial_history = true  # don't flood Matrix on first run

[mailing_list]
list_id = "mylist.example.com"               # partial match on List-Id header
# sender_domains = ["lists.example.com"]     # fallback if no List-Id
# sender_emails = ["listname@example.com"]   # exact sender match
# subject_prefix = "[mylist]"               # subject prefix filter

[security]
admin_users = ["@you:matrix.org"]
# Who may invite the bot:
#   "all"                      — accept invites from any Matrix user
#   []                         — reject all invites
#   ["@you:matrix.org"]        — explicit allowlist
allowed_inviters = ["@you:matrix.org"]
# Rooms the bot may join and bridge emails into:
#   "all"                      — operate in any room
#   []                         — refuse to operate in any room
#   ["!roomid:matrix.org"]     — explicit allowlist
# Both allowed_inviters and allowed_rooms must pass before an invite is accepted.
allowed_rooms = "all"
encryption_strategy = "all_devices"
# Matrix users allowed to send email replies via the bridge.
# If empty (or absent), all room members may reply.
# allowed_repliers = ["@you:matrix.org"]

# Optional: enable Matrix → Email reply bridging.
# Remove this section entirely to run in read-only (Email → Matrix only) mode.
[smtp]
host = "smtp.example.com"
port = 587               # 587 for STARTTLS (default), 465 for SMTPS
username = "bot@example.com"
# password loaded from SMTP_PASSWORD env var
from_address = "bot@example.com"   # address in the From header of bridge replies
list_address = "list@lists.example.com"  # mailing list posting address (To + Reply-To)
# require_smtps = false  # set true if your server requires implicit TLS on port 465
# allow_new_threads_from_matrix = false  # true: top-level Matrix messages create new list emails
# list_confirmation_timeout_secs = 3600  # optional: notify after 1h without a list echo; never auto-resends

[limits]
max_attachment_bytes = 10485760  # 10MB
max_body_bytes = 524288          # 512KB
max_quote_lines = 5

[security.verification]
# Users allowed to complete first-time verification. If omitted or empty,
# an explicit allowed_inviters list is used as the fallback.
allowed_users = ["@you:matrix.org"]
# Also allow first-time verification for users sharing a joined room with the bot.
allow_users_from_joined_rooms = false
# SAS-only verification limits.
flow_timeout_secs = 300
grant_ttl_secs = 600
max_concurrent = 8

[security.admin_dm]
# Admins can open a direct chat with the bot and manage it there:
#   !admin status | verify | settings | set <key> <value> | unset <key>
# `!admin verify` starts mutual emoji (SAS) verification with you.
enabled = true
# Only accept admin commands in end-to-end encrypted direct chats.
require_encryption = true
# Only accept admin commands from devices the bot has verified (recommended
# once you and the bot have verified each other).
require_verified_device = false
# Also deliver broadcast posts (summaries, digests, …) into admin chats.
receive_broadcasts = false
